# Copy to backend/.env and adjust. Never commit real keys.

# --- Core ---
ENVIRONMENT=development
# Default is a SQLite file in the backend folder. Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/bookmycare
# DATABASE_URL=sqlite:///./bookmycare.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15

# --- AI providers (all optional). Without a working provider the app runs in clearly-labelled MOCK mode. ---
# Gemini is the primary provider. Create a key at https://aistudio.google.com/apikey and paste it below.
# Never commit backend/.env; it is git-ignored.
AI_PROVIDER_ORDER=gemini,groq,openrouter
AI_FORCE_MOCK=false
# true  = if no real AI works, show a template summary that is labelled "Mock AI"
# false = show "AI explanation unavailable" instead of any template text
AI_ALLOW_MOCK_FALLBACK=true
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4096
GEMINI_API_KEY=
# Model names are retired regularly (gemini-2.0-flash and groq llama-3.3-70b-versatile no longer work).
# Free-tier limits are per model. Measured 2026-10-25: gemini-3.8-flash hung or returned 503; gemini-3.6-flash allowed only 20 requests/day;
# gemini-3.5-flash-lite was fast and reliable. Check limits for your key at https://aistudio.google.com/rate-limit
# Check https://ai.google.dev/gemini-api/docs/deprecations and https://console.groq.com/docs/deprecations
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# OpenRouter is only used when a model id is set here.
OPENROUTER_MODEL=

# --- OCR (optional). Needed only for scanned PDFs and photos of reports. ---
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Safety messaging ---
EMERGENCY_NUMBER=112
CRISIS_LINE=Tele-MANAS 14416 (India, 24x7 mental health helpline)
